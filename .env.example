# Shared
APP_ENV=development
ENABLE_DEV_AUTH=true
BACKEND_API_KEY=change-me-in-production
# Backend-only, temporary overlap for a coordinated key rotation. Never set on
# the frontend; remove it after both services use the new BACKEND_API_KEY.
BACKEND_API_KEY_NEXT=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
# Compatibility alias only; prefer SUPABASE_SECRET_KEY in new environments.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=profile-documents

# Backend
DATABASE_URL=sqlite:///./data/career_fit_ai.db
DATABASE_POOL_SIZE=1
DATABASE_MAX_OVERFLOW=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=5242880
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=
GITHUB_TOKEN=
CRON_SECRET=
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://127.0.0.1:8000
SCORE_CALIBRATION_PATH=

# Independent Goozali discovery beta. Keep disabled until the explicit UUID
# allowlist, migration, scheduler, and operational monitoring are ready.
GOOZALI_DISCOVERY_ENABLED=false
GOOZALI_EMBED_URL=https://airtable.com/embed/appwewqLk7iUY4azc/shrQBuWjXd0YgPqV6?backgroundColor=cyan&viewControls=on
GOOZALI_INITIAL_LOOKBACK_HOURS=72
GOOZALI_MAX_JOBS_PER_RUN=40
GOOZALI_BETA_USER_IDS=

# Optional high-confidence email alerts for enrolled beta users.
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_SIGNING_SECRET=

# Frontend
BACKEND_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=/backend
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OCR worker deployment (set these on the worker, not the frontend/backend).
# OCR_WORKER_TOKEN must equal the backend OCR_SERVICE_TOKEN, never the URL.
OCR_WORKER_TOKEN=
OCR_LANGUAGES=eng+heb+ara
OCR_MAX_BYTES=8388608
OCR_MAX_PAGES=8
OCR_DPI=220
OCR_MAX_PAGE_PIXELS=20000000
OCR_MAX_TOTAL_PIXELS=50000000
OCR_PAGE_TIMEOUT_SECONDS=25
OCR_REQUEST_TIMEOUT_SECONDS=75
OCR_MAX_CONCURRENT_REQUESTS=1

# Staging smoke script only; do not set in production application deployments.
SMOKE_TARGET_ENV=staging
SMOKE_FRONTEND_URL=
SMOKE_BACKEND_URL=
SMOKE_SUPABASE_URL=
SMOKE_SUPABASE_ANON_KEY=
SMOKE_SUPABASE_SECRET_KEY=
SMOKE_INTERNAL_KEY=
SMOKE_STORAGE_BUCKET=profile-documents
SMOKE_EMAIL_DOMAIN=example.com
